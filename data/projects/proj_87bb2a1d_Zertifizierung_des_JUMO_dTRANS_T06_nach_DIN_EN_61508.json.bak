{
  "id": "proj_87bb2a1d",
  "name": "Zertifizierung des JUMO dTRANS T06 nach DIN EN 61508",
  "description": "Bauteil FMEDA auf Bauteil-Ebene, JUMO dTRANS T06",
  "version": "2.01",
  "project_number": "70.0058",
  "status": "under_review",
  "created_by": "SWN",
