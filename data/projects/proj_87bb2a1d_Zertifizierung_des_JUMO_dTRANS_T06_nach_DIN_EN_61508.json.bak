  "hardware_version": null,
  "software_version": null,
  "safety_context": {
    "safety_function_name": "Sicherheitsfunktion",
    "safety_function_description": "Nach NAMUR-Empfehlung NE 43:\n\ngültiges Ausgangssignal zwischen 3,8 mA und 20,5 mA --> Messinformation M;\n\nAusgangssignal im Fehlerfall des Messumformers ≤ 3,6 mA oder ≥ 21,0 mA --> Ausfallinformation A (Fühlerkurzschluss Fühlerbruch);\n\nim Fehlerfall fällt das Relais in den stromlosen Zustand (Ruhestromprinzip)",
    "safe_state": "Analog Output mit Ausfallinformation A nach NE43; Abschalten des Ruhestromkreises des Relais;",
    "dangerous_state": "Analog Output nicht im Zustand Ausfallinformation A nach NE43; das nicht Abschalten des Ruhestromkreises mittels Relais bei Anforderung;\n``",
    "safety_architecture": "1oo1D",
    "operating_mode": "Low demand mode",
    "safety_boundary": "Elektrische Sicherheit nach DIN EN 61010-1, Überspannungskategorie III, Verschmutzungsgrad 2; Elektromagnetische Verträglichkeit nach DIN EN 61326-1; 61326-3-2; 61326-2-3",
    "external_sensor_included": false,
    "no_part_failure_definition": "Bauteile, die nicht Bestandteil der Sicherheitsfunktion sind (entspricht der Anforderung aus DIN EN 61508-2:2011 Anhang C Punkt c; \"no part failure\" nach DIN EN 61508-4:2011 Punkt 3.6.13).",
    "no_effect_failure_definition": "Bauteile, die Bestandteil der Sicherheitsfunktion sind, deren Ausfall aber keine direkte Auswirkung auf die Sicherheitsfunktion hat (entspricht der Anforderung aus DIN EN 61508-2:2011 Anhang C Punkt c; \"no effect failure\" nach DIN EN 61508-4:2011 Punkt 3.6.14).",
    "notes": "FMEDA auf Bauteilebene; in diesem Dokument wird nur die FMEDA betrachtet.\n\n\n\nFehlerbetrachtung nach DIN EN 61508-2 Tabelle A1, entsprechende Aufteilung siehe \"Fehleraufteilung\"."
  },
